# Database Connection String
# Local/VPS PostgreSQL: postgresql://identifyyou_user:your_password@127.0.0.1:5432/identifyyou
# Hosted Supabase/Neon: postgresql://postgres:your_password@db.your-ref.supabase.co:5432/postgres
DATABASE_URI=postgresql://postgres:your_secure_password@127.0.0.1:5432/identifyyou

# Database SSL Configuration:
# - 'false' or 'disable': Disables SSL (recommended for local dev, PM2 local postgres, and internal Docker)
# - 'true' or 'require': Enables verified SSL (required for hosted Supabase, Neon, AWS RDS)
# - 'allow-unauthorized': Enables SSL without certificate verification (for custom self-signed certs)
DATABASE_SSL=false

# Payload Secret Key (random 32+ characters)
PAYLOAD_SECRET=change-me-to-a-long-random-secret-string-32chars

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase S3 Storage (for media file uploads in production)
# Get from Supabase -> Project Settings -> Storage -> S3 Credentials
# S3_BUCKET=media
# S3_ENDPOINT=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=[YOUR-S3-ACCESS-KEY-ID]
# S3_SECRET_ACCESS_KEY=[YOUR-S3-SECRET-ACCESS-KEY]
# S3_REGION=us-east-1

# Optional: Umami Analytics (100% Open Source, Cookie-Free)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
# NEXT_PUBLIC_UMAMI_HOST_URL=http://your-vps-ip:3001

# ----------------------------------------------------------------------
# EMAIL / SMTP SETTINGS (Contact Form Notifications)
# ----------------------------------------------------------------------
# Replace these with your actual Hostinger SMTP credentials
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@identifyyou.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@identifyyou.com
# The email address where contact form submissions will be sent
CONTACT_EMAIL_TO=office@identifyyou.com

# ----------------------------------------------------------------------
# DATABASE BACKUP SETTINGS
# ----------------------------------------------------------------------
# How many backup .sql files to keep in the /backups folder (oldest pruned)
BACKUP_KEEP=10
