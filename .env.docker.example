# ======================================================================
# IDENTIFYOUT + UMAMI DOCKER COMPOSE CONFIGURATION (.env)
# Copy this file to .env on your Hostinger VPS:
#   cp .env.docker.example .env
# ======================================================================

# ----------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CREDENTIALS
# ----------------------------------------------------------------------
POSTGRES_USER=identifyyou
# Replace with a strong, random password:
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ----------------------------------------------------------------------
# 2. PAYLOAD CMS SECRET
# ----------------------------------------------------------------------
# Generate a 32+ character random secret (e.g. openssl rand -base64 32)
PAYLOAD_SECRET=your_random_32_characters_payload_secret_here

# ----------------------------------------------------------------------
# 3. DOMAIN & URLS
# ----------------------------------------------------------------------
# Replace with your actual domain
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
PAYLOAD_PUBLIC_SERVER_URL=https://yourdomain.com
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com

# ----------------------------------------------------------------------
# 4. UMAMI ANALYTICS CONFIGURATION
# ----------------------------------------------------------------------
# Any 32-char random string used by Umami container for encryption
UMAMI_APP_SECRET=your_random_32_characters_umami_secret_here

# Umami host URL (your analytics subdomain)
NEXT_PUBLIC_UMAMI_HOST_URL=https://analytics.yourdomain.com

# Website ID obtained after logging into Umami dashboard (UUID format)
# Note: You can launch containers first, get this ID from the dashboard, then add it and run `docker compose up -d app`
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ----------------------------------------------------------------------
# 5. EMAIL / SMTP SETTINGS (Hostinger Email)
# ----------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_hostinger_email_password
SMTP_FROM=contact@yourdomain.com
CONTACT_EMAIL_TO=office@yourdomain.com
