{
  "name": "identifyyou-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-payload-hydration.js",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "node --import tsx/esm scripts/init_tables.ts && next start",
    "db:init": "node --import tsx/esm scripts/init_tables.ts",
    "lint": "eslint",
    "generate:importmap": "node --import tsx/esm ./node_modules/payload/bin.js generate:importmap",
    "seed": "node --import tsx/esm scripts/seed.ts --run",
    "db:backup": "node --import tsx/esm scripts/backup_db.ts",
    "db:restore": "node --import tsx/esm scripts/restore_db.ts",
    "storage:export": "node --import tsx/esm scripts/export_storage.ts",
    "umami:setup": "node --import tsx/esm scripts/setup_umami.ts",
    "db:migrate": "node --import tsx/esm ./node_modules/payload/bin.js migrate",
    "db:migrate:create": "node --import tsx/esm ./node_modules/payload/bin.js migrate:create",
    "db:migrate:down": "node --import tsx/esm ./node_modules/payload/bin.js migrate:down",
    "test": "node --import tsx/esm scripts/test_production_readiness.ts",
    "test:prod": "node --import tsx/esm scripts/test_production_readiness.ts",
    "test:e2e": "node --env-file=.env.local --import tsx/esm scripts/verify_full_system.ts",
    "email:test": "node --import tsx/esm scripts/test_email.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^7.2.1",
    "@next/third-parties": "^16.3.8",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "graphql": "^16.10.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.13",
    "payload": "^3.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "mammoth": "^1.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
